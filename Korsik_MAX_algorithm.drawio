<mxCell id="n14" value="Кнопки: 1) Да, жду не дождусь!  2) Готов/Готова  3) Да, но немного волнуюсь" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#d5f0d0;strokeColor=#2e7d32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="435" y="252" width="310" height="44" as="geometry"/></mxCell><mxCell id="n15" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="351" width="340" height="88" as="geometry"/></mxCell><mxCell id="n16" value="Ответ 1–2" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="351" width="340" height="28" as="geometry"/></mxCell><mxCell id="n17" value="Супер! Мне нравится твой настрой ✨" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="65" y="389" width="310" height="40" as="geometry"/></mxCell><mxCell id="e18" value="1–2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n10" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="790" y="351" width="340" height="92" as="geometry"/></mxCell><mxCell id="n20" value="Ответ 3" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="351" width="340" height="28" as="geometry"/></mxCell><mxCell id="n21" value="Это нормально немного волноваться… я сам через это проходил 😓" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="389" width="310" height="44" as="geometry"/></mxCell><mxCell id="e22" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n10" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="488" width="340" height="107" as="geometry"/></mxCell><mxCell id="n24" value="Напоминание о документах" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="488" width="340" height="28" as="geometry"/></mxCell><mxCell id="n25" value="Весь первый день мы проведём вместе. Напоминаю список документов [Изобр. 3]: GrPP/Luzhniki 8 пунктов, GTP 9 (+фото 3×4)" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="526" width="310" height="59" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n15" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n19" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="640" width="340" height="196" as="geometry"/></mxCell><mxCell id="n29" value="10:00 Поздравление и доступы" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#21