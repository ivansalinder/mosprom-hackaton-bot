=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="705" width="340" height="107" as="geometry"/></mxCell><mxCell id="n30" value="Факты о компании" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="705" width="340" height="28" as="geometry"/></mxCell><mxCell id="n31" value="Факт №1: чистая вода и экология&lt;br&gt;Факт №2: развитие и карьера&lt;br&gt;Факт №3: филиалы по России и СНГ" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="743" width="310" height="59" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n18" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n23" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="857" width="340" height="161" as="geometry"/></mxCell><mxCell id="n35" value="Завершение pre-boarding" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="857" width="340" height="28" as="geometry"/></mxCell><mxCell id="n36" value="Очень скоро начнём полноценное погружение, а пока отдыхай. Напишу за день до выхода. До встречи, Х! 👋" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spaci