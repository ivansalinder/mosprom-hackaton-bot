 id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n25" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="ПАРАЛЛЕЛЬНО НА ВСЕХ ЭТАПАХ:&lt;br&gt;• свободный вопрос → ИИ-ассистент (RAG) → ответ по базе знаний или эскалация&lt;br&gt;• ответы опросов → анализ тональности → красные флаги → HR&lt;br&gt;• напоминания о непройденных опросах&lt;br&gt;• команды /Food, /HR" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="420" height="140" as="geometry"/></mxCell><mxCell id="n34" value="Завершение: бот прощается; сотрудник может обращаться к ИИ-ассистенту и HR" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=40;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="920" width="340" height="60" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n29" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="1. Старт и регистрация" id="60802855"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Блок 1. Приветствие, привязка, подтверждение данных, форма общения" style="html=1;whiteSpace=wrap;fontSize=11;text;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="n3" value="Блок" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent=