"1220" width="310" height="40" as="geometry"/></mxCell><mxCell id="n41" value="(сохранить в профиль; все следующие тексты — в выбранной форме)&lt;br&gt;«Очень приятно с тобой познакомиться, Х!»" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="1270" width="310" height="59" as="geometry"/></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n27" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n32" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n44" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="1384" width="340" height="122" as="geometry"/></mxCell><mxCell id="n45" value="Знакомство с Корсиком" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="1384" width="340" height="28" as="geometry"/></mxCell><mxCell id="n46" value="Меня зовут Корсик, я помогу быстро и легко адаптироваться… [Изобр. 1]&lt;br&gt;В течение 3 месяцев буду сопровождать тебя и давать полезную информацию." style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="1422" width="310" height="74" as="geometry"/></mxCell><mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n37" target="n44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n48" value="Переход к блоку «Документы и подготовка к выходу»" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=40;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="1551" width="340" height="50" as="geometry"/></mxCell><mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n44" target="n48"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Pre-boarding" id="92116598"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Блок 2. За 2–3 дня до выхода: документы, транспорт, факты" style="html=1;whiteSpace=wrap;fontSize=11;text;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="n3" value="Блок" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="150" height="30" as="geometry"/></mxCell><mxCell id="n4" value="Сообщение бота" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="200" y="55" width="150" height="30" as="geometry"/></mxCell><mxCell id="n5" value="Действие пользователя" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#d5f0d0;strokeColor=#2e7d32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="360" y="55" width="150" height="30" as="geometry"/></mxCell><mxCell id="n6" value="Отложенное уведомление" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#fde0c2;strokeColor=#c77c2a;" vertex="1" pare