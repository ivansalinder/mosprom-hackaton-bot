" parent="1"><mxGeometry x="420" y="618" width="340" height="246" as="geometry"/></mxCell><mxCell id="n22" value="День 3, 11:00. Спортзал (GTP)" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="618" width="340" height="28" as="geometry"/></mxCell><mxCell id="n23" value="Триггер: 11:00, тег GTP" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#fde0c2;strokeColor=#c77c2a;" vertex="1" parent="1"><mxGeometry x="435" y="656" width="310" height="40" as="geometry"/></mxCell><mxCell id="n24" value="На территории есть спортивный комплекс. Рассказать о расписании и оснащении?" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="706" width="310" height="44" as="geometry"/></mxCell><mxCell id="n25" value="Да / Нет" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#d5f0d0;strokeColor=#2e7d32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="435" y="760" width="310" height="40" as="geometry"/></mxCell><mxCell id="n26" value="Да → расписание и оснащение [контент — запросить]" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="810" width="310" height="44" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n16" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="909" width="340" height="246" as="geometry"/></mxCell><mxCell id="n29" value="17:30. Опрос по итогам 3-го дня" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="909" width="340" height="28" as="geometry"/></mxCell><mxCell id="n30" value="Триггер: день 3, 17:30" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#fde0c2;strokeColor=#c77c2a;" vertex="1" parent="1"><mxGeometry x="435" y="947" width="310" height="40" as="geometry"/></mxCell><mxCell id="n31" value="Первые дни бывают непростыми — пройди короткий опрос." style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="997" width="310" height="44" as="geometry"/></mxCell><mxCell id="n32" value="ВОПРОС 1: Были ли вопросы при оформлении?" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="1051" width="310" height="40" as="geometry"/></mxCell><mxCell id="n33" value="А) Всё отлично!  Б) Остались вопросы  В) Трудности с документами" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#d5f0d0;strokeColor=#2e7d32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="435" y="1101" width="310" height="44" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n21" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="1200" width="340" height="146" as="geometry"/></mxCell><mxCell id="n36" value="Ответ Б" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="1200" width="340" height="28" as="geometry"/></mxCell><mxCell id="n37" value="Помни, что ты всегда можешь связаться с рекрутером." style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="65" y="1238" width="310" height="44" as="geometry"/></mxCell><mxCell id="n38" value="Кнопка «Связаться с рекрутером» → диалог с рекрутером" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#d5f0d0;strokeColor=#2e7d32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="65" y="1292" width="310" height="44" as="geometry"/></mxCell><mxCell id="e39" value="Б" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n28" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="790" y="1200" width="340" height="192" as="geometry"/></mxCell><mxCell id="n41" value="Ответ В" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="1200" width="340" height="28" as="geometry"/></mxCell><mxCell id="n42" value="Почему не получилось изучить документы? В чём проблема?" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="1238" width="310" height="44" as="geometry"/></mxCell><mxCell id="n43" value="Пишет текст ИЛИ «Связаться с рекрутером»" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#d5f0d0;strokeColor=#2e7d32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="805" y="1292" width="310" height="40" as="geometry"/></mxCell><mxCell id="n44" value="Анализ тональности и темы → тикет HR" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="1342" width="310" height="40" as="geometry"/></mxCell><mxCell id="e45" value="В" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n28" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n46" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="1437" width="340" height="142" as="geometry"/></mxCell><mxCell id="n47" value="ВОПРОС 2" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="1437" width="340" height="28" as="geometry"/></mxCell><mxCell id="n48" value="Как тебя встретили новые коллеги?" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="1475" width="310" height="40" as="geometry"/></mxCell><mxCell id="n49" value="А) Отлично!  Б) Присматриваюсь  В) Никак, все заняты" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#d5f0d0;strokeColor=#2e7d32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="435" y="1525" width="310" height="44" as="geometry"/></mxCell><mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n35" target="n46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n40" target="n46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n52" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="790" y="1624" width="340" height="196" as="geometry"/></mxCell><mxCell id="n53" value="Ответ В" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="1624" width="340" height="28" as="geometry"/></mxCell><mxCell id="n54" value="Жаль… Возможно, ты вышел в период нагрузки. Подними вопрос с руководителем или напиши в HR." style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="1662" width="310" height="44" as="geometry"/></mxCell><mxCell id="n55" value="Передать проблему в HR через Корсика / Связаться с HR" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#d5f0d0;strokeColor=#2e7d32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="805" y="1716" width="310" height="44" as="geometry"/></mxCell><mxCell id="n56" value="Тикет HR" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="1770" width="310" height="40" as="geometry"/></mxCell><mxCell id="e57" value="В" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n46" target="n52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n58" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="1865" width="340" height="142" as="geometry"/></mxCell><mxCell id="n59" value="ВОПРОС 3" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="1865" width="340" height="28" as="geometry"/></mxCell><mxCell id="n60" value="Понятны ли задачи на испытательный срок?" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="1903" width="310" height="40" as="geometry"/></mxCell><mxCell id="n61" value="А) Да, всё понятно!  Б) Жду разъяснений  В) Пока ничего не понял" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#d5f0d0;strokeColor=#2e7d32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="435" y="1953" width="310" height="44" as="geometry"/></mxCell><mxCell id="e62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n52" target="n58"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n63" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="2052" width="340" height="92" as="geometry"/></mxCell><mxCell id="n64" value="Ответ Б" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="2052" width="340" height="28" as="geometry"/></mxCell><mxCell id="n65" value="Если разъяснений нет — обсуди с руководителем. Можно связаться с рекрутером." style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="65" y="2090" width="310" height="44" as="geometry"/></mxCell><mxCell id="e66" value="Б" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n58" target="n63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n67" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="790" y="2052" width="340" height="161" as="geometry"/></mxCell><mxCell id="n68" value="Ответ В" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="2052" width="340" height="28" as="geometry"/></mxCell><mxCell id="n69" value="Понимание задач — ключ к ИС. Обсуди с руководителем; если не прояснилось — напиши в отдел персонала." style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="2090" width="310" height="59" as="geometry"/></mxCell><mxCell id="n70" value="Передать через Корсика / связаться с рекрутером → тикет" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="2159" width="310" height="44" as="geometry"/></mxCell><mxCell id="e71" value="В" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n58" target="n67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n72" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="2258" width="340" height="142" as="geometry"/></mxCell><mxCell id="n73" value="Завершение опроса" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="2258" width="340" height="28" as="geometry"/></mxCell><mxCell id="n74" value="Спасибо за обратную связь! Увидимся завтра 👋🏻" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="2296" width="310" height="40" as="geometry"/></mxCell><mxCell id="n75" value="Если опрос не пройден: напоминание через 1 день и ещё через 1 день [Изобр. 12]" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#fde0c2;strokeColor=#c77c2a;" vertex="1" parent="1"><mxGeometry x="435" y="2346" width="310" height="44" as="geometry"/></mxCell><mxCell id="e76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n63" target="n72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n67" target="n72"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5. Месяцы 1–3" id="49806800"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Блок 5. От +10 дней до конца испытательного срока" style="html=1;whiteSpace=wrap;fontSize=11;text;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="n3" value="Блок" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="150" height="30" as="geometry"/></mxCell><mxCell id="n4" value="Сообщение бота" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="200" y="55" width="150" height="30" as="geometry"/></mxCell><mxCell id="n5" value="Действие пользователя" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#d5f0d0;strokeColor=#2e7d32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="360" y="55" width="150" height="30" as="geometry"/></mxCell><mxCell id="n6" value="Отложенное уведомление" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#fde0c2;strokeColor=#c77c2a;" vertex="1" parent="1"><mxGeometry x="520" y="55" width="150" height="30" as="geometry"/></mxCell><mxCell id="n7" value="Уведомление HR / email" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#e0e0e0;strokeColor=#666666;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="680" y="55" width="150" height="30" as="geometry"/></mxCell><mxCell id="n8" value="ИИ-модуль" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="55" width="150" height="30" as="geometry"/></mxCell><mxCell id="n9" value="Эскалация" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1000" y="55" width="150" height="30" as="geometry"/></mxCell><mxCell id="n10" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="340" height="142" as="geometry"/></mxCell><mxCell id="n11" value="+10 дней. Корпоративные мероприятия" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="340" height="28" as="geometry"/></mxCell><mxCell id="n12" value="Триггер: +10 дней (GrPP, Luzhniki)" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#fde0c2;strokeColor=#c77c2a;" vertex="1" parent="1"><mxGeometry x="435" y="148" width="310" height="40" as="geometry"/></mxCell><mxCell id="n13" value="Как мы проводим корпоративные мероприятия? [Изобр. 11] + фото с мероприятий" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="198" width="310" height="44" as="geometry"/></mxCell><mxCell id="n14" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="297" width="340" height="357" as="geometry"/></mxCell><mxCell id="n15" value="+2 недели. Чек-опрос (9 вопросов)" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="297" width="340" height="28" as="geometry"/></mxCell><mxCell id="n16" value="Триггер: +2 недели" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#fde0c2;strokeColor=#c77c2a;" vertex="1" parent="1"><mxGeometry x="435" y="335" width="310" height="40" as="geometry"/></mxCell><mxCell id="n17" value="Как дела? Нужна ли помощь? Вопросы 1–9: Да/Нет и шкалы 1–10 (задачи, информация, руководитель ×2, коллеги, доступы ×2, поддержка HR ×2)" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="385" width="310" height="59" as="geometry"/></mxCell><mxCell id="n18" value="Отвечает кнопкой / шкалой" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#d5f0d0;strokeColor=#2e7d32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="435" y="454" width="310" height="40" as="geometry"/></mxCell><mxCell id="n19" value="Оценка &lt; 8 или «Нет» → «Укажи причину»" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="504" width="310" height="40" as="geometry"/></mxCell><mxCell id="n20" value="Пишет текст" st