=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="435" y="1369" width="310" height="59" as="geometry"/></mxCell><mxCell id="n53" value="Кнопки: Да, всё есть / Нет" style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=25;fillColor=#d5f0d0;strokeColor=#2e7d32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="435" y="1438" width="310" height="40" as="geometry"/></mxCell><mxCell id="e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n39" target="n49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n44" target="n49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n56" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="1533" width="340" height="88" as="geometry"/></mxCell><mxCell id="n57" value="Всё есть" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#2196f3;strokeColor=#2196f3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="1533" width="340" height="28" as="geometry"/></mxCell><mxCell id="n58" value="Замечательно! Осваивайся, напишу позже." style="html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=18;fillColor=#dbeafe;strokeColor=#3b6ea8;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="65" y="1571" width="310" height="40" as="geometry"/></mxCell><mxCell id="e59" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n49" target="n56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n60" value="" style="html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeCo